.libPaths(c("/home/ssaab/links/projects/def-itobias/R_libs/4.4.0", .libPaths()))



# Load Libraries ====
library(SingleR)
library(BiocParallel)
library(Seurat)
library(SingleCellExperiment)
library(readxl)
library(org.Mm.eg.db)
library(clusterProfiler)

embryo_atlas_20pct <- readRDS("embryo_atlas_20pct_singleR_reference_cells.rds")

#Need to supply a named list of character vectors to 'genes'
#That is the marker_character_list
# 
# class(embryo_atlas_20pct) #It is SingleCellExperiment

#Change gene names to gene symbol ----
#Do this before making matrix because matrix is big

#Fix gene names
#Map EnsembleIDs to symbols

#Cluster profiler -> package -> Add another column with the gene symbols
#Tobias did this on only the markers that were exported
#Teratoma dataset genes are in symbols
# 
head(embryo_atlas_20pct) #Rownames are ensembl gene names

ensembl_ids <- rownames(embryo_atlas_20pct)
length(ensembl_ids) #27669

ref_symbols <- mapIds(
  org.Mm.eg.db, #Mouse annotation database
  keys = ensembl_ids,
  column = "SYMBOL",
  keytype = "ENSEMBL",
  #Keep the first match if duplicated
)

length(ref_symbols)

rowData(embryo_atlas_20pct)$gene_symbol <- ref_symbols

keep_indices <- !is.na(rowData(embryo_atlas_20pct)$gene_symbol)
table(keep_indices) #TRUE 22777, FALSE 4892

#Get the non-NA rows to subset
embryo_atlas_20pct <- embryo_atlas_20pct[keep_indices, ]

